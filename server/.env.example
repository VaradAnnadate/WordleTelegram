# Server Configuration
PORT=3000
CLIENT_URL=http://localhost:5173

# Redis Configuration (Optional but recommended for production)
# Redis URL for persistent room storage across server restarts and multiple instances
# On Railway, this is automatically provided as RAILWAY_REDIS_URL
# Locally, you can use: redis://localhost:6379
REDIS_URL=

# Game Configuration
# Timer duration for solving (in seconds). Default is 180 seconds (3 minutes)
GAME_TIME_LIMIT_SECONDS=180
# Time allowed for picking challenge words (in milliseconds). Default is 60000 (1 minute)
WORD_SELECTION_TIME_MS=60000

# Telegram Bot Integration (Optional)
# Obtain from @BotFather on Telegram. If set, the server responds to /start with a Mini App launch button!
TELEGRAM_BOT_TOKEN=
# Your deployed public URL (e.g. https://your-wordle-app.up.railway.app). Used by the bot to link to the Mini App.
WEBAPP_URL=
